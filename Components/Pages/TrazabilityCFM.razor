@code {
    // Custom pagination properties
    private List<CommonResult> AllRecords { get; set; } = new();
    private List<CommonResult> PagedRecords => AllRecords
        .Skip(CurrentPage * PageSize)
        .Take(PageSize)
        .ToList();
    private int PageSize { get; set; } = 10;
    private int CurrentPage { get; set; } = 0;
    private int TotalPages => (int)Math.Ceiling(AllRecords.Count / (double)PageSize);
    private List<CommonResult> LastModelResults = new();

    // Selección de celda (A, B o C)
    // Campo privado de respaldo
    private string _selectedCell = "";

    /// <summary>
    /// Obtiene los últimos 3 registros de TorquesBrasilFanMotor o TorquesBrasilFinalAssembly
    /// según el tipo de filtro ("Time" o "Motor") y el valor de filtro proporcionado.
    /// </summary>
    // --------------------------------------------------
    // 2) GetLastThreeModelRecordsAsync sin null-propagation
    // --------------------------------------------------
   private async Task<List<CommonResult>> GetLastThreeModelRecordsAsync()
{
    var fanQuery = context.FanMotor.AsQueryable();
    var asmQuery = context.FinalAssembly.AsQueryable();

    if (SelectedFilterType == "Motor" && !string.IsNullOrEmpty(FilterValue))
    {
        // Coincidencia exacta: VIN debe ser igual al motor code
        fanQuery = fanQuery.Where(f => f.VIN != null && f.VIN == FilterValue);
            asmQuery = asmQuery.Where(a => a.VIN != null && a.VIN == FilterValue);

    }

    var fanEntities = await fanQuery
        .OrderByDescending(f => f.TorqueValue_TIMESTAMP)
        .Take(3)
        .ToListAsync();

    var asmEntities = await asmQuery
        .OrderByDescending(a => a.TorqueValue_TIMESTAMP)
        .Take(3)
        .ToListAsync();

    var fanResults = fanEntities.Select(f => new CommonResult
        {
                Source = "FanMotor",
                TorqueTimestamp = f.TorqueValue_TIMESTAMP,
                MotorFan = f.VIN,

                AngleMin = f.AngleMin,
                AngleValue = f.AngleValue,
                AngleMax = f.AngleMax,

                TorqueMin = f.TorqueMin,
                TorqueValue = f.TorqueValue.HasValue ? (decimal?)f.TorqueValue.Value : null,
                TorqueMax = f.TorqueMax,
                TorqueTarget = f.TorqueTarget,

                AngleTarget = f.AngleTarget

        });

    var asmResults = asmEntities.Select(a => new CommonResult
        {
            Source = "FinalAssembly",
                TorqueTimestamp = a.TorqueValue_TIMESTAMP,
                MotorFan = a.VIN,

                AngleMin = a.AngleMin,
                AngleValue = a.AngleValue,
                AngleMax = a.AngleMax,

                TorqueMin = a.TorqueMin,
                TorqueValue = a.TorqueValue.HasValue ? (decimal?)a.TorqueValue.Value : null,
                TorqueMax = a.TorqueMax,
                TorqueTarget = a.TorqueTarget,

                AngleTarget = a.AngleTarget
        });

    return fanResults.Concat(asmResults).OrderByDescending(r => r.TorqueTimestamp).ToList();
}


    // Propiedad pública que dispara la búsqueda automática al cambiar
    public string SelectedCell
    {
        get => _selectedCell;
        set
        {
            if (_selectedCell == value) return;
            _selectedCell = value;

            // Cuando cambia la celda, si ya hay filtro y valor completo, auto‐aplicar
            InvokeAsync(async () =>
            {
                if (string.IsNullOrEmpty(SelectedFilterType) ||
                    string.IsNullOrEmpty(_selectedCell))
                    return;

                IsLoading = true;
                StateHasChanged();

                // Permitimos que el spinner se pinte
                await Task.Yield();

                if (SelectedFilterType == "Interval")
                    await TryAutoApplyInterval();
                else
                    await TryAutoApplyFilter();

                IsLoading = false;
                StateHasChanged();
            });
        }
    }

    // Tipo de filtro
    private string _selectedFilterType = "";
    private string SelectedFilterType
    {
        get => _selectedFilterType;
        set
        {
            if (_selectedFilterType != value)
            {
                // Guardar el valor anterior para verificación
                string oldValue = _selectedFilterType;

                // Actualizar el valor inmediatamente
                _selectedFilterType = value;

                // Mostrar el indicador de carga
                IsLoading = true;

                // Ejecutar el cambio de tipo de filtro asincrónicamente
                InvokeAsync(async () =>
                {
                    // Pequeño retraso para que la UI tenga tiempo de actualizar el indicador de carga
                    await Task.Delay(10);

                    // Verificar que el filtro no haya cambiado mientras esperábamos
                    if (_selectedFilterType == value && oldValue != value)
                    {
                        try
                        {
                            // Realizar las operaciones necesarias al cambiar el filtro
                            OnFilterTypeChanged();
                        }
                        finally
                        {
                            // Ocultar el indicador de carga
                            IsLoading = false;
                            StateHasChanged();
                        }
                    }
                });
            }
        }
    }

    // Valores para poblar el segundo combobox
    private List<string> FilterValuesList { get; set; } = new();

    // Inputs del filtro
    private string FilterValue { get; set; } = string.Empty;
