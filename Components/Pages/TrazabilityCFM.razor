                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" checked="@ShowLeftBlade" @onchange="@(e => { ShowLeftBlade = (bool)e.Value; StateHasChanged(); })" id="chkLeftBlade" />
                        <label class="form-check-label" for="chkLeftBlade">Left Blade</label>
                    </div>
                </div>

                <!-- Grupo 4 -->
                <div class="col-3">

                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" checked="@ShowLeftRadius" @onchange="@(e => { ShowLeftRadius = (bool)e.Value; StateHasChanged(); })" id="chkLeftRadius" />
                        <label class="form-check-label" for="chkLeftRadius">Left Radius</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" checked="@ShowLeftClip" @onchange="@(e => { ShowLeftClip = (bool)e.Value; StateHasChanged(); })" id="chkLeftClip" />
                        <label class="form-check-label" for="chkLeftClip">Left Clip</label>
                    </div>
