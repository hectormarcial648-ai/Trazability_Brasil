            <!-- Nuevo: Filtro de Final Status -->
            <h5 class="mt-3">Final Status Filter</h5>
            <div class="mb-2">
                <button class="btn btn-sm btn-outline-primary me-2"
                        @onclick="SelectAllStatus">
                    Select All
                </button>
                <button class="btn btn-sm btn-outline-secondary"
                        @onclick="DeselectAllStatus">
                    Deselect All
                </button>
            </div>
            <div class="row">
                <div class="col-4">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" checked="@ShowStatusPass"
                               @onchange="async (e) => { ShowStatusPass = (bool)e.Value; await RefreshFilters(); }"
                               id="chkStatusPass" />
                        <label class="form-check-label" for="chkStatusPass">PASS</label>
                    </div>
                </div>
                <div class="col-4">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" checked="@ShowStatusFail"
