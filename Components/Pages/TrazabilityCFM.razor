                               id="chkStatusFail" />
                        <label class="form-check-label" for="chkStatusFail">FAIL</label>
                    </div>
                </div>
                <div class="col-4">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" checked="@ShowStatusReject"
                               @onchange="async (e) => { ShowStatusReject = (bool)e.Value; await RefreshFilters(); }"
                               id="chkStatusReject" />
                        <label class="form-check-label" for="chkStatusReject">REJECT</label>
                    </div>
                </div>
            </div>
        </div>
    </div>
