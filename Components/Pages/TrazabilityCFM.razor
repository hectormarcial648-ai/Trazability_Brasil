    // ——— Validación de intervalo ———
    private void ValidateIntervalInput()
    {
        // Start
        IntervalStartError = string.Empty;
        if (!string.IsNullOrEmpty(IntervalStart) && !IntervalStart.All(char.IsDigit))
            IntervalStartError = "Start time must contain only digits";
        else if (IntervalStart.Length > 0 && IntervalStart.Length < 14)
            IntervalStartError = "Start time must be exactly 14 digits";

        // End
        IntervalEndError = string.Empty;
        if (!string.IsNullOrEmpty(IntervalEnd) && !IntervalEnd.All(char.IsDigit))
            IntervalEndError = "End time must contain only digits";
        else if (IntervalEnd.Length > 0 && IntervalEnd.Length < 14)
            IntervalEndError = "End time must be exactly 14 digits";
    }
   private async void OnFilterTypeChanged()
{
    ClearFilterInputs();
    UpdateFilterValuesList();

    // Limpiar mensajes de error
    FilterValueError = string.Empty;
    IntervalStartError = string.Empty;
    IntervalEndError = string.Empty;

    // Limpiar la tabla para que no queden registros viejos
    AllRecords.Clear();
    CurrentPage = 0;

    // NUEVO: También limpiar Fan Motor cuando cambies el tipo de filtro
    LastModelResults = await GetLastThreeModelRecordsAsync();

    // Refrescar UI
    StateHasChanged();
}


    private void ClearFilterInputs()
    {
        FilterValue = "";
        IntervalStart = "";
        IntervalEnd = "";
    }

    private void UpdateFilterValuesList()
    {
        FilterValuesList.Clear();

        if (SelectedFilterType == "Interval" || string.IsNullOrEmpty(SelectedCell))
            return;

        // Raw times según celda
        IQueryable<string> rawTimes = SelectedCell switch
        {
            "A" => context.Bal17.Select(r => r.Time).Union(context.Bal18.Select(r => r.Time)),
            "B" => context.Bal15.Select(r => r.Time).Union(context.Bal16.Select(r => r.Time)),
            "C" => context.Bal11.Select(r => r.Time).Union(context.Bal12.Select(r => r.Time)),
            _ => Enumerable.Empty<string>().AsQueryable()
        };

        IEnumerable<string> transformed = SelectedFilterType switch
        {
            "Time" => rawTimes,
            "Day" => rawTimes.Select(t => t.Length >= 8 ? t.Substring(0, 8) : t),
            "Month" => rawTimes.Select(t => t.Length >= 6 ? t.Substring(0, 6) : t),
            "Motor" => SelectedCell switch
            {
                "A" => context.Bal17.Select(r => r.MotorCode.Length >= 13
                                                  ? r.MotorCode.Substring(0, 13)
                                                  : r.MotorCode)
                           .Union(context.Bal18.Select(r => r.MotorCode.Length >= 13
                                                  ? r.MotorCode.Substring(0, 13)
                                                  : r.MotorCode)),
                "B" => context.Bal15.Select(r => r.MotorCode.Length >= 13
                                                  ? r.MotorCode.Substring(0, 13)
                                                  : r.MotorCode)
                           .Union(context.Bal16.Select(r => r.MotorCode.Length >= 13
                                                  ? r.MotorCode.Substring(0, 13)
                                                  : r.MotorCode)),
                "C" => context.Bal11.Select(r => r.MotorCode.Length >= 13
                                                  ? r.MotorCode.Substring(0, 13)
                                                  : r.MotorCode)
                           .Union(context.Bal12.Select(r => r.MotorCode.Length >= 13
                                                  ? r.MotorCode.Substring(0, 13)
                                                  : r.MotorCode)),
                _ => Enumerable.Empty<string>()
            },
            _ => Enumerable.Empty<string>()
        };

        FilterValuesList = transformed
            .Where(v => !string.IsNullOrEmpty(v))
            .Distinct()
            .OrderBy(v => v)
            .ToList();
    }

    // Custom pagination methods
    private void FirstPage()
    {
        CurrentPage = 0;
    }

    private void PreviousPage()
    {
        if (CurrentPage > 0)
            CurrentPage--;
    }

    private void NextPage()
    {
        if (CurrentPage < TotalPages - 1)
            CurrentPage++;
    }

    private void LastPage()
    {
        CurrentPage = Math.Max(0, TotalPages - 1);
    }

    private void GoToPage(int pageNumber)
    {
        CurrentPage = pageNumber;
    }

