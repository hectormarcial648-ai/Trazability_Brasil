            _ => 20
        };
    }

    // Manejar entrada del filtro principal con autocompletado y búsqueda automática
    /// <summary>
    /// Se dispara en cuanto cambias el texto del filtro principal.
    private void ValidateFilterInput(ChangeEventArgs e)
    {
        var value = e.Value?.ToString() ?? string.Empty;
        FilterValueError = string.Empty;

        switch (SelectedFilterType)
        {
            case "Time":
                if (!string.IsNullOrEmpty(value) && !value.All(char.IsDigit))
                    FilterValueError = "Time must contain only digits";
                else if (value.Length > 0 && value.Length < 14)
                    FilterValueError = "Time must be exactly 14 digits";
                break;

            case "Day":
                if (!string.IsNullOrEmpty(value) && !value.All(char.IsDigit))
                    FilterValueError = "Day must contain only digits";
                else if (value.Length > 0 && value.Length < 8)
                    FilterValueError = "Day must be exactly 8 digits (YYYYMMDD)";
                break;

            case "Month":
                if (!string.IsNullOrEmpty(value) && !value.All(char.IsDigit))
                    FilterValueError = "Month must contain only digits";
                else if (value.Length > 0 && value.Length < 6)
                    FilterValueError = "Month must be exactly 6 digits (YYYYMM)";
                break;

            case "Motor":
                if (!string.IsNullOrEmpty(value) && !value.All(char.IsDigit))
                    FilterValueError = "Motor code must contain only digits";
                else if (value.Length > 0 && value.Length < 13)
                    FilterValueError = "Motor code must be exactly 13 digits";
                break;
        }
    }

    // ——— Auto-aplicar filtro principal ———
    private async Task OnFilterValueChanged(ChangeEventArgs e)
    {
        FilterValue = e.Value?.ToString() ?? string.Empty;
        ValidateFilterInput(e);
        await TryAutoApplyFilter();
    }

    private async Task TryAutoApplyFilter()
{
    if (!string.IsNullOrEmpty(SelectedCell)
        && !string.IsNullOrEmpty(SelectedFilterType)
        && string.IsNullOrEmpty(FilterValueError)
        && FilterValue.Length == GetFilterMaxLength())
    {
        IsLoading = true;
        StateHasChanged();
        try
        {
            await Task.Delay(1);
            AllRecords = GetFilteredRecords().ToList();
            CurrentPage = 0;
            
            // NUEVO: También actualizar Fan Motor en auto-aplicación
            LastModelResults = await GetLastThreeModelRecordsAsync();
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }
}

    // ——— Auto-aplicar intervalo ———
    private async Task OnIntervalStartChanged(ChangeEventArgs e)
    {
        IntervalStart = e.Value?.ToString() ?? string.Empty;
        ValidateIntervalInput();
