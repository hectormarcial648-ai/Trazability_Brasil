    private Task HandleKeyDownIntervalStart(KeyboardEventArgs e)
    {
        return HandleKeyDownInterval(e, "intervalStart");
    }

    private Task HandleKeyDownIntervalEnd(KeyboardEventArgs e)
    {
        return HandleKeyDownInterval(e, "intervalEnd");
    }

    private ConexionesBral context = default!;

    protected override void OnInitialized()
    {
        context = DbFactory.CreateDbContext();

        SelectedCell = ""; // Default to cell A
        PageSize = 10; // Default page size
        UpdateFilterValuesList();
    }

    // Método para refrescar los filtros y limpiar caché
    private async Task RefreshFilters()
    {
        // Limpiar la caché de resultados
        AllRecords.Clear();
        CurrentPage = 0;

        // Aplicar filtros inmediatamente
        await ApplyFilters();

        // Llamar al JavaScript para forzar la actualización del DOM
        if (JSRuntime != null)
        {
            try
            {
                await JSRuntime.InvokeVoidAsync("eval", "void(0);");
            }
            catch { }
        }
    }

    /// <summary>
    /// Method to load records based on current filter criteria
    /// </summary>
    private async Task ApplyFilters()
{
    try
    {
        IsLoading = true;
        StateHasChanged();

        await Task.Delay(1);

        var cancellationTokenSource = new CancellationTokenSource(TimeSpan.FromSeconds(10));
        var cancellationToken = cancellationTokenSource.Token;

        await Task.Run(async () =>
        {
            try
            {
                AllRecords = GetFilteredRecords().ToList();

                if (AllRecords.Count > 1000)
                {
                    AllRecords = AllRecords.Take(1000).ToList();
                }

                CurrentPage = 0;
            }
            catch (OperationCanceledException)
            {
                AllRecords = GetFilteredRecords().Take(200).ToList();
            }
        }, cancellationToken);

        // IMPORTANTE: Actualizar también los datos de Fan Motor cuando cambie el filtro
        LastModelResults = await GetLastThreeModelRecordsAsync();
    }
    catch (Exception ex)
    {
        Console.WriteLine($"Error al aplicar filtros: {ex.Message}");
        AllRecords = new List<CommonResult>();
        LastModelResults = new List<CommonResult>();
    }
    finally
    {
        IsLoading = false;
        StateHasChanged();
    }
}

    // Manejo de eventos keydown para el filtro principal
    private Task HandleKeyDown(KeyboardEventArgs e)
    {
        // Si no es una tecla de navegación o control y ya alcanzamos la longitud máxima
        if (FilterValue?.Length >= GetFilterMaxLength() &&
            !e.Key.StartsWith("Arrow") &&
            e.Key != "Backspace" &&
            e.Key != "Delete" &&
            e.Key != "Tab" &&
            !e.CtrlKey)
        {
            // Para teclas que no son de control, limita la entrada
            if (e.Key.Length == 1) // Probablemente un carácter imprimible
            {
                // Actualiza el valor para asegurar que no exceda el límite
                FilterValue = FilterValue.Substring(0, GetFilterMaxLength());
                StateHasChanged();
            }
        }
        return Task.CompletedTask;
    }

    // Manejo de eventos keydown para campos de intervalo
    private Task HandleKeyDownInterval(KeyboardEventArgs e, string fieldName)
    {
        string currentValue = fieldName == "intervalStart" ? IntervalStart : IntervalEnd;

        // Si no es una tecla de navegación o control y ya alcanzamos la longitud máxima
        if (currentValue?.Length >= 14 &&
            !e.Key.StartsWith("Arrow") &&
            e.Key != "Backspace" &&
            e.Key != "Delete" &&
            e.Key != "Tab" &&
            !e.CtrlKey)
        {
            // Para teclas que no son de control, limita la entrada
            if (e.Key.Length == 1) // Probablemente un carácter imprimible
            {
                // Actualiza el valor para asegurar que no exceda el límite
                if (fieldName == "intervalStart")
                    IntervalStart = IntervalStart.Substring(0, 14);
                else
                    IntervalEnd = IntervalEnd.Substring(0, 14);

                StateHasChanged();
            }
        }
        return Task.CompletedTask;
    }

