@page "/trazabilityCFM"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.QuickGrid
@using Microsoft.AspNetCore.Components.Forms
@using System.Linq.Expressions
@using TrazabilityBrasil.Models
@using TrazabilityBrasil.Data
@inject IDbContextFactory<ConexionesBral> DbFactory
@implements IAsyncDisposable
@using Microsoft.JSInterop
@inject IJSRuntime JSRuntime

<PageTitle>B15Bal Records</PageTitle>

<div class="container-fluid">
    <!-- Fila 1: Comboboxes (izq) y checkboxes (der) -->
    <div class="row mb-4">
        <!-- Izquierda: Comboboxes/Input -->
        <div class="col-md-6">
            <div class="form-group mb-3">
                <label for="filterType">Filter Type</label>
                <InputSelect id="filterType" class="form-select"
                             @bind-Value="SelectedFilterType">
                    <option value="">-- Select Filter Type --</option>
                    <option value="Time">Time</option>
                    <option value="Day">Day</option>
                    <option value="Month">Month</option>
                    <option value="Interval">Interval</option>
                    <option value="Motor">Motor</option>
                </InputSelect>
            </div>

            @if (SelectedFilterType == "Interval")
            {
                <div class="form-group mb-3">
                    <label for="intervalStart">Interval Start</label>
                    <InputText id="intervalStart"
                               class="form-control"
                               @bind-Value="IntervalStart"
                               placeholder="Start Time (14 digits)"
                               maxlength="14"
                               @oninput="OnIntervalStartChanged"
                               @onkeydown="HandleKeyDownIntervalStart" />
                    @if (!string.IsNullOrEmpty(IntervalStartError))
                    {
                        <div class="text-danger">@IntervalStartError</div>
                    }
                </div>
                <div class="form-group mb-3">
                    <label for="intervalEnd">Interval End</label>
                    <InputText id="intervalEnd"
                               class="form-control"
                               @bind-Value="IntervalEnd"
                               placeholder="End Time (14 digits)"
                               maxlength="14"
                               @oninput="OnIntervalEndChanged"
                               @onkeydown="HandleKeyDownIntervalEnd" />
                    @if (!string.IsNullOrEmpty(IntervalEndError))
                    {
                        <div class="text-danger">@IntervalEndError</div>
                    }
                </div>
            }
            else if (!string.IsNullOrEmpty(SelectedFilterType))
            {
                <div class="form-group mb-3">
                    <label for="filterValue">Value</label>
                    <InputText id="filterValue"
                               class="form-control"
                               @bind-Value="FilterValue"
                               placeholder="@GetFilterPlaceholder()"
                               maxlength="@GetFilterMaxLength()"
                               @oninput="OnFilterValueChanged"
                               @onkeydown="HandleKeyDown" />
                    @if (!string.IsNullOrEmpty(FilterValueError))
                    {
                        <div class="text-danger">@FilterValueError</div>
                    }
                </div>
            }

            <div class="form-group mb-3">
                <label for="cellSelect">Cell</label>
                <InputSelect id="cellSelect" class="form-select"
                             @bind-Value="SelectedCell">
                    <option value="">-- Select Cell --</option>
                    <option value="C">Celda 1</option>
                    <option value="B">Celda 2</option>
                    <option value="A">Celda 4</option>
                </InputSelect>
            </div>

            <div class="form-group mb-3">
                <button class="btn btn-primary" @onclick="ApplyFilters">
                    Apply Filters
                </button>
            </div>
        </div>

        <!-- Derecha: Checkboxes -->
        <div class="col-md-6">
            <h5>Show Columns</h5>
            <div class="mb-2">
                <button class="btn btn-sm btn-outline-primary me-2"
                        @onclick="SelectAllColumns">
                    Select All
                </button>
                <button class="btn btn-sm btn-outline-secondary"
                        @onclick="DeselectAllColumns">
                    Deselect All
                </button>
            </div>
            <div class="row">
                <!-- Grupo 1 -->
                <div class="col-3">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" checked="@ShowTime" @onchange="@(e => { ShowTime = (bool)e.Value; StateHasChanged(); })" id="chkTime" />
                        <label class="form-check-label" for="chkTime">Time</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" checked="@ShowUser" @onchange="@(e => { ShowUser = (bool)e.Value; StateHasChanged(); })" id="chkUser" />
                        <label class="form-check-label" for="chkUser">User</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" checked="@ShowMotorCode" @onchange="@(e => { ShowMotorCode = (bool)e.Value; StateHasChanged(); })" id="chkMotorCode" />
                        <label class="form-check-label" for="chkMotorCode">Motor Code</label>
                    </div>

                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" checked="@ShowFinalStatus" @onchange="@(e => { ShowFinalStatus = (bool)e.Value; StateHasChanged(); })" id="chkFinalStatus" />
                        <label class="form-check-label" for="chkFinalStatus">Final Status</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" checked="@ShowVoltage" @onchange="@(e => { ShowVoltage = (bool)e.Value; StateHasChanged(); })" id="chkVoltage" />
                        <label class="form-check-label" for="chkVoltage">Voltage</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" checked="@ShowCurrent" @onchange="@(e => { ShowCurrent = (bool)e.Value; StateHasChanged(); })" id="chkCurrent" />
                        <label class="form-check-label" for="chkCurrent">Current</label>
                    </div>
                </div>

                <!-- Grupo 2 -->
                <div class="col-3">

                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" checked="@ShowSpeed" @onchange="@(e => { ShowSpeed = (bool)e.Value; StateHasChanged(); })" id="chkSpeed" />
                        <label class="form-check-label" for="chkSpeed">Speed</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" checked="@ShowStaticValue" @onchange="@(e => { ShowStaticValue = (bool)e.Value; StateHasChanged(); })" id="chkStaticValue" />
                        <label class="form-check-label" for="chkStaticValue">Static</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" checked="@ShowStaticAngle" @onchange="@(e => { ShowStaticAngle = (bool)e.Value; StateHasChanged(); })" id="chkStaticAngle" />
                        <label class="form-check-label" for="chkStaticAngle">Static Angle</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" checked="@ShowCouple" @onchange="@(e => { ShowCouple = (bool)e.Value; StateHasChanged(); })" id="chkCouple" />
                        <label class="form-check-label" for="chkCouple">Couple</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" checked="@ShowCoupleAngle" @onchange="@(e => { ShowCoupleAngle = (bool)e.Value; StateHasChanged(); })" id="chkCoupleAngle" />
                        <label class="form-check-label" for="chkCoupleAngle">Couple Angle</label>
                    </div>
                    <div class="form-check">
